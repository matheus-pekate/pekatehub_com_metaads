# Copie este arquivo para .env e preencha com seu token real
VITE_PIPEDRIVE_TOKEN=seu_token_aqui

# Usadas pela função serverless /api/chats (histórico de conversas da Laura)
# Em produção, configure estas variáveis no dashboard da Vercel (Project Settings > Environment Variables)
REDIS_HOST=seu_host_redis
REDIS_PORT=6379
REDIS_PASSWORD=sua_senha_redis
